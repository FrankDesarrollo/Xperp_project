{
	"name": "xperp-frontend",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"gen:api": "openapi-typescript ../contracts/openapi/openapi.yaml -o src/lib/api/schema.d.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@lucide/svelte": "^1.61.0",
		"echarts": "^6.1.0",
		"openapi-fetch": "^0.17.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@testing-library/jest-dom": "^6.10.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^22.20.5",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^16.5.0",
		"jsdom": "^26.1.0",
		"msw": "^2.15.0",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.5.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^7.3.7",
		"vitest": "^3.2.7"
	},
	"msw": {
		"workerDirectory": [
			"static"
		]
	}
}
