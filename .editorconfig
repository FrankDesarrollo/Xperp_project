root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
# google-java-format (Spotless) usa 2 espacios
indent_size = 2
max_line_length = 100

[*.{svelte,ts,js,json,css,html}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf

[Makefile]
indent_style = tab
